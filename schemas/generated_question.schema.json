{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated_question.schema.json",
  "title": "Generated Math Question",
  "type": "object",
  "required": [
    "question_id",
    "category",
    "subcategory",
    "difficulty",
    "question",
    "answer_type",
    "canonical_answer",
    "display_answer",
    "unit",
    "tolerance",
    "order_sensitive",
    "generation_source",
    "reference_hard_sample_ids",
    "target_error_type",
    "generation_strategy"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "Arithmetic",
        "Algebra",
        "Geometry & Trigonometry",
        "Probability & Statistics",
        "Word Problems",
        "Number Theory",
        "Calculus",
        "Linear Algebra",
        "Composite Comprehensive"
      ]
    },
    "subcategory": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "target_difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "observed_difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "difficulty_profile": {
      "type": "object",
      "required": [
        "rubric_version",
        "score",
        "band",
        "confidence",
        "dimensions"
      ],
      "properties": {
        "rubric_version": {
          "const": "observable_math_v1"
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "band": {
          "enum": [
            "foundational",
            "routine_multistep",
            "integrated",
            "advanced",
            "expert"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dimensions": {
          "type": "object",
          "required": [
            "reasoning_steps",
            "operation_count",
            "constraint_count",
            "symbolic_depth",
            "representation_load"
          ]
        }
      },
      "additionalProperties": true
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer_type": {
      "enum": [
        "integer",
        "decimal",
        "rational",
        "percentage",
        "boolean",
        "text",
        "symbolic_expression",
        "equation",
        "inequality",
        "set",
        "interval",
        "ordered_tuple",
        "unordered_collection",
        "vector",
        "matrix",
        "unit_value",
        "multiple_choice"
      ]
    },
    "canonical_answer": {},
    "exact_canonical_answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_answer": {
      "type": "string"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "tolerance": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "order_sensitive": {
      "type": "boolean"
    },
    "generation_source": {
      "enum": [
        "hard_pool_variant",
        "coverage_deficit",
        "retention_known"
      ]
    },
    "reference_hard_sample_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "generation_guidance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^guide-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "target_error_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation_strategy": {
      "type": "string",
      "minLength": 1
    },
    "truth_validation_details": {
      "type": "object"
    },
    "failure_type": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
