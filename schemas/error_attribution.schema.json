{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error_attribution.schema.json",
  "title": "Error Attribution",
  "type": "object",
  "required": [
    "is_correct",
    "primary_error_tag",
    "secondary_error_tags",
    "evidence",
    "attribution_confidence",
    "needs_review",
    "deterministic_checks"
  ],
  "properties": {
    "is_correct": {
      "type": "boolean"
    },
    "primary_error_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "secondary_error_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "response_span",
          "reason"
        ],
        "properties": {
          "response_span": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "check_name": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "step_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "attribution_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_review": {
      "type": "boolean"
    },
    "deterministic_checks": {
      "type": "object"
    },
    "attribution_method": {
      "type": "string"
    },
    "verification_tier": {
      "type": "string"
    },
    "first_error_step": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "taxonomy_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
