{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test_taker_output.schema.json",
  "title": "Structured Test-Taker Output",
  "type": "object",
  "required": [
    "reasoning_summary",
    "final_answer",
    "answer_type",
    "confidence"
  ],
  "properties": {
    "reasoning_summary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "final_answer": {
      "type": "string",
      "minLength": 1
    },
    "answer_type": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
